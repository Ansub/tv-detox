<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    package="com.ansub.tvhome" android:versionCode="20" android:versionName="1.5.7">
    <uses-sdk android:minSdkVersion="21" android:targetSdkVersion="34" />
    <!-- Only for the network tile: Wi-Fi, Ethernet or offline, and the Wi-Fi signal. -->
    <uses-permission android:name="android.permission.ACCESS_NETWORK_STATE" />
    <uses-permission android:name="android.permission.ACCESS_WIFI_STATE" />
    <!-- Android 11+ only shows apps a home screen asks to see: TV apps and normal apps. -->
    <queries>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
        </intent>
        <intent>
            <action android:name="android.intent.action.MAIN" />
            <category android:name="android.intent.category.LAUNCHER" />
        </intent>
        <!-- Settings screens the network tile and the Bluetooth, Sound and Picture shortcuts open. -->
        <intent><action android:name="android.settings.WIFI_SETTINGS" /></intent>
        <intent><action android:name="android.settings.BLUETOOTH_SETTINGS" /></intent>
        <intent><action android:name="com.google.android.intent.action.CONNECT_INPUT" /></intent>
        <intent><action android:name="android.settings.SOUND_SETTINGS" /></intent>
        <intent><action android:name="android.settings.DISPLAY_SETTINGS" /></intent>
        <package android:name="com.tcl.settings" />
        <!-- Some TCL Google TVs ship TCL's Picture and Sound panels inside TvSettings. -->
        <package android:name="com.android.tv.settings" />
        <!-- Google TV's HDMI input player, so HDMI tiles can see when the TV sends HDMI to it. -->
        <package android:name="com.google.android.tv.inputplayer" />
        <!-- Google TV's own home screen, which HomeButton opens when Back is held. -->
        <package android:name="com.google.android.apps.tv.launcherx" />
        <!-- The Settings screen: the TV's screensavers, System UI's screensaver preview, TV settings. -->
        <intent><action android:name="android.service.dreams.DreamService" /></intent>
        <package android:name="com.android.systemui" />
        <intent><action android:name="android.settings.SETTINGS" /></intent>
    </queries>
    <!-- The Settings screen. WRITE_SETTINGS and WRITE_SECURE_SETTINGS let it change the screensaver and
         sleep timers; install.sh grants them over adb, and the TV never asks. Without them the page
         only shows the current values. -->
    <uses-permission android:name="android.permission.WRITE_SETTINGS" />
    <uses-permission android:name="android.permission.WRITE_SECURE_SETTINGS" />
    <!-- Only to list paired Bluetooth devices there. On Android 12+ install.sh grants it. -->
    <uses-permission android:name="android.permission.BLUETOOTH" android:maxSdkVersion="30" />
    <uses-permission android:name="android.permission.BLUETOOTH_CONNECT" />
    <!-- Lets "Uninstall" in the app menu open Android's uninstall prompt. -->
    <uses-permission android:name="android.permission.REQUEST_DELETE_PACKAGES" />
    <uses-feature android:name="android.software.leanback" android:required="false" />
    <uses-feature android:name="android.hardware.touchscreen" android:required="false" />
    <application android:label="Home" android:allowBackup="false" android:banner="@drawable/banner" android:icon="@drawable/icon"
        android:theme="@android:style/Theme.Material.NoActionBar.Fullscreen">
        <activity android:name=".MainActivity"
            android:exported="true"
            android:launchMode="singleTask" android:stateNotNeeded="true"
            android:clearTaskOnLaunch="true" android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode|locale">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.HOME" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <!-- A tile in the TV's own apps row, for TVs where the TV's home screen stays on. -->
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LEANBACK_LAUNCHER" />
            </intent-filter>
        </activity>
        <activity android:name=".SettingsActivity"
            android:exported="false"
            android:excludeFromRecents="true"
            android:screenOrientation="landscape"
            android:configChanges="keyboard|keyboardHidden|navigation|orientation|screenSize|screenLayout|uiMode" />
        <!-- Starfield, a screensaver that comes with the home screen. It only runs while it shows. -->
        <service android:name=".StarfieldDream" android:label="Starfield" android:exported="true"
            android:permission="android.permission.BIND_DREAM_SERVICE">
            <intent-filter>
                <action android:name="android.service.dreams.DreamService" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
        </service>
        <!-- Opt-in: makes Home open this home screen where the TV's own has to stay on (Google TV). -->
        <service android:name=".HomeButton" android:label="Home button" android:exported="true"
            android:permission="android.permission.BIND_ACCESSIBILITY_SERVICE">
            <intent-filter>
                <action android:name="android.accessibilityservice.AccessibilityService" />
            </intent-filter>
            <meta-data android:name="android.accessibilityservice" android:resource="@xml/home_button" />
        </service>
    </application>
</manifest>
